{
  "name": "m6-ambiente-backend",
  "version": "0.1.0",
  "description": "Backend del Módulo 6 — Ambiente, Higiene y Servicios Urbanos. Municipalidad UADE, DAPS2 2026.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "core:register": "ts-node -P tsconfig.json scripts/core-register.ts",
    "core:unregister": "ts-node -P tsconfig.json scripts/core-unregister.ts",
    "espacios-verdes:build": "ts-node -P tsconfig.json scripts/build-espacios-verdes.ts",
    "datos-ciudad:build": "ts-node -P tsconfig.json scripts/build-datos-ciudad.ts",
    "zones:sync-from-core": "ts-node -P tsconfig.json scripts/zones-sync-from-core.ts",
    "m1:export-cuentas": "ts-node -P tsconfig.json scripts/export-cuentas-m1.ts",
    "crews:migrate-user-ids": "ts-node -P tsconfig.json scripts/migrate-crew-user-ids.ts",
    "openapi:generate": "ts-node -P tsconfig.json scripts/generate-openapi.ts",
    "api:collection": "node scripts/build-postman-collection.mjs",
    "docs:check": "node scripts/check-docs-integracion.mjs && node scripts/check-docs.mjs",
    "docs:roles": "ts-node -P tsconfig.json scripts/generate-roles-table.ts",
    "qa:pdf": "node scripts/build-qa-pdf.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.18.0",
    "amqplib": "^2.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "multer": "^2.4.0",
    "body-parser": "^1.20.9",
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
