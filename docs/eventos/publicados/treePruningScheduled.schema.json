{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uade.m6.grupo04/eventos/treePruningScheduled.schema.json",
  "title": "treePruningScheduled",
  "description": "M6 → M7. Se programó una intervención de poda. Informativo: si requiresStreetClosure es true, después sale streetClosureRequested.",
  "type": "object",
  "properties": {
    "interventionId": { "type": "string" },
    "serviceId": { "type": "string", "description": "El Service que la ejecuta. Va explícito para poder correlacionar." },
    "interventionType": {
      "type": "string",
      "enum": ["FORMATION_PRUNING", "SAFETY_PRUNING", "REMOVAL", "PLANTING", "TREATMENT"],
      "description": "CONFLICTO SIN RESOLVER: el acuerdo publicado declara PRUNING | FELLING | PLANTING | TREATMENT. Ver enumeraciones.md, divergencia 4."
    },
    "treeIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "zoneId": { "type": "string" },
    "location": { "$ref": "_shared.schema.json#/$defs/location" },
    "scheduledDate": { "$ref": "_shared.schema.json#/$defs/date" },
    "timeWindow": { "$ref": "_shared.schema.json#/$defs/timeWindow" },
    "crewId": { "type": "string" },
    "requiresStreetClosure": { "type": "boolean" }
  },
  "required": ["interventionId", "serviceId", "interventionType", "treeIds", "zoneId", "location", "scheduledDate", "timeWindow", "crewId", "requiresStreetClosure"],
  "additionalProperties": false
}
