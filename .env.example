# ─── Server ───────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/m6_ambiente?schema=public

# ─── JWT / Auth ───────────────────────────────────
# Pendiente de M9: el claim set del JWT todavía no está definido.
# Estos valores son placeholder para desarrollo local.
JWT_SECRET=CHANGE_ME_local_dev_secret_m6
JWT_EXPIRATION=3600

# ─── Kafka (confirmado por M9, sin broker expuesto todavia) ──
# Sin KAFKA_BROKERS la app arranca igual: los eventos se encolan en el
# outbox y se registran en el log, sin publicarse a ningun bus.
# KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=m6-ambiente
KAFKA_GROUP_ID=m6-ambiente-group
