# ─── Server ───────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────
# Local: apunta al postgres del docker-compose (workspace raíz).
# Producción (Render) usa Supabase: la URI directa (puerto 5432) se carga
# como DATABASE_URL en el panel de Render, no acá. Ver docs/deploy.md.
DATABASE_URL=postgresql://user:password@localhost:5432/m6_ambiente?schema=public

# ─── CORS ─────────────────────────────────────────
# Origenes que pueden llamar a la API desde un navegador, separados por coma.
# Sin la variable se aceptan todos, que es lo que hace falta en desarrollo.
# En Render se carga la URL del frontend.
# CORS_ORIGINS=https://frontend-m6-daps2-grupo4-modulo6.vercel.app

# ─── JWT / Auth ───────────────────────────────────
# El JWT lo emite M1 (identidad, ADR-004). Pendiente de M1: el contrato de
# firma y el claim set todavía no están definidos (docs/bloqueantes.md).
# Estos valores son placeholder para desarrollo local.
JWT_SECRET=CHANGE_ME_local_dev_secret_m6
JWT_EXPIRATION=3600

# ─── Control ambiental ──────────────────────────
# Dias que esperamos la resolucion de M4 antes de cerrar el expediente.
SANCTION_DEADLINE_DAYS=30

# ─── RabbitMQ (bus del Core, M9) ──
# Sin RABBITMQ_URL la app arranca igual: los eventos se encolan en el outbox
# y se registran en el log, y no se consume nada del bus.
# El usuario y la clave van solo en la URL; la app loguea el host sin
# credenciales. La clave va percent-encoded si tiene / ? # @ : o % (por
# ejemplo "a/b@c" se escribe "a%2Fb%40c"). Si queda un @ fuera de la
# userinfo la app no arranca: parte de la clave terminaria en el log.
# En produccion (NODE_ENV=production) es obligatorio amqps://.
# RABBITMQ_URL=amqp://usuario:clave@localhost:5672/vhost
# Core real de M9 (ambiente unico y compartido, vhost "core" en la ruta; la clave
# la entrega M9 por privado y NO va en el repo ni en capturas):
# RABBITMQ_URL=amqps://module_ambiente:<clave-percent-encoded>@core-uade-2026.duckdns.org:5671/core
# En produccion amqp:// no arranca. El puerto 5671 abre solo para la IP de salida
# de Render que M9 haya dado de alta.
# El usuario de la URL va como userId de cada mensaje: M9 lo va a verificar contra
# sourceModule (hoy por AMQP no valida). Tiene que ser el del modulo ("ambiente"),
# nunca guest; en produccion guest no arranca. No es el CORE_MODULE_SECRET.
#
# Exchange y cola los crea el Core; M6 solo los verifica (modo pasivo).
# Publicamos todo a muni.inbox (fanout) y consumimos de nuestra cola.
RABBITMQ_EXCHANGE=muni.inbox
RABBITMQ_QUEUE=q.ambiente
# Mensajes sin confirmar a la vez. Los reintentos y la DLQ los hace el Core
# (escalones de 5 s, 30 s, 2 min y 10 min segun el intento, docs/integracion/m9.md): el orden de llegada no esta garantizado.
RABBITMQ_PREFETCH=1

# ─── Core (M9) ──────────────────────────────────
# Nuestro modulo ante el Core: va como sourceModule en el sobre.
CORE_MODULE_ID=ambiente
# API REST del Core. Sin CORE_API_URL la app arranca igual y no se le pide
# nada al Core. Con ella, CORE_MODULE_SECRET es obligatoria. En produccion
# (NODE_ENV=production) es obligatorio https://.
# El secret lo entrega M9: en Render se carga en el panel, nunca en el repo.
# Core real: CORE_API_URL=https://core-uade-2026.duckdns.org
# (readiness: /health/ready; la API es /api/v1). El secret NO va aca.
# CORE_API_URL=https://core.example.com
# CORE_MODULE_SECRET=
# Registro de suscripciones y publicaciones en el catalogo del Core (al arrancar,
# solo con CORE_API_URL; tambien: npm run core:register). maxAttempts por
# suscripcion (4 = cadena de reintentos del Core) y interruptor del arranque.
# CORE_SUBSCRIPTION_MAX_ATTEMPTS=4
# CORE_REGISTER_ON_BOOT=true   (acepta true/false/1/0, sin distinguir mayusculas)

# ─── Cloudflare R2 (evidencia/adjuntos, Issue #64) ──
# Sin estas variables la app arranca igual, pero POST /evidence falla al subir.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=m6-evidence
# R2_PUBLIC_URL_BASE=https://pub-xxxx.r2.dev
