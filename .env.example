# ══════════════════════════════════════════════════════════════════════════
# Variables de entorno del backend M6 (Ambiente, Higiene y Servicios Urbanos)
#
# Cómo leer este archivo
#   · Línea sin comentar  → valor que sirve tal cual para desarrollo local.
#   · Línea comentada (#) → no se carga en local: va solo donde dice «DÓNDE».
#   · DÓNDE: LOCAL = tu .env (no versionado) · RENDER = panel del servicio
#     backend · CI = workflow de GitHub Actions · VERCEL = panel del frontend.
#   · Los SECRETOS (claves, secrets, tokens) NUNCA van en este archivo ni en
#     el repo: acá solo hay placeholders. Los valores reales se cargan en el
#     panel de Render y los entregan M1 y M9 por privado (grupo de POs).
#   · Detalle de cada una y de cómo desplegar: docs/deploy.md.
# ══════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────
# DÓNDE: LOCAL. En RENDER no se define PORT: lo inyecta la plataforma.
PORT=3000
# HOST es opcional (default 0.0.0.0); no hace falta definirlo en ningún lado.
# DÓNDE: LOCAL = development · RENDER = production (obligatorio: activa los
# chequeos de https/amqps y rechaza el usuario guest de RabbitMQ).
NODE_ENV=development

# ─── Database ─────────────────────────────────────
# DÓNDE: LOCAL = el postgres del docker-compose (workspace raíz).
# RENDER = la URI directa de Supabase, puerto 5432, con ?schema=public:
#   postgresql://<usuario>:<clave>@<host-supabase>:5432/postgres?schema=public
# CI = la define el workflow (postgresql://m6:m6@localhost:5432/m6_e2e).
# Los e2e truncan la base: apuntarlos solo a una local (docs/testing.md), nunca
# a la de Render/Supabase. El Dockerfile corre `prisma migrate deploy` al arrancar.
DATABASE_URL=postgresql://user:password@localhost:5432/m6_ambiente?schema=public

# ─── CORS ─────────────────────────────────────────
# DÓNDE: RENDER = la URL del frontend en Vercel. LOCAL: sin definir (acepta todo).
# CORS_ORIGINS=https://frontend-m6-daps2-grupo4-modulo6.vercel.app

# ─── JWT / Auth (el JWT lo emite M1, ADR-004) ─────
# JWT_SECRET = el APP_JWT_SECRET de M1: HS256, en BASE64, mínimo 32 bytes.
# DÓNDE: RENDER (SECRETO). M1 manda el valor real por el grupo de POs; hasta
# entonces, uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOCAL = este placeholder, válido pero NO es un secreto: con NODE_ENV=production
# la app no arranca con él (ni con un secreto de un solo byte repetido). El BFF
# del frontend (VERCEL: M6_DEV_JWT) firma su token de demo con este mismo valor.
JWT_SECRET=Q0hBTkdFX01FX2xvY2FsX2Rldl9zZWNyZXRfbTZfMzJieXRlcw==
# `iss` que se exige en el token. Es el de M1; no hace falta tocarlo en RENDER.
JWT_ISSUER=modulo1-ciudadanos
# Ids de M1 (el `sub` del token, numérico) de los M6_ADMIN iniciales, separados por
# coma: sin ellos nadie puede asignar roles. Además necesitan RESPONSABLE_AREA en M1.
# DÓNDE: RENDER (no es secreto, pero define quién administra M6). LOCAL: opcional.
# M6_BOOTSTRAP_ADMIN_USER_IDS=1,42

# ─── Control ambiental ────────────────────────────
# DÓNDE: opcional en ambos. Días que esperamos la resolución de M4 antes de
# cerrar el expediente (default 30).
SANCTION_DEADLINE_DAYS=30

# ─── RabbitMQ (bus del Core, M9) ──────────────────
# Sin RABBITMQ_URL la app arranca igual: los eventos se encolan en el outbox y
# se registran en el log, y no se consume nada del bus.
# DÓNDE: RENDER (SECRETO: lleva la clave). En LOCAL, solo para probar contra un
# broker propio (amqp://guest:guest@localhost:5672/ en desarrollo).
# Core real de M9 (ambiente único y compartido; vhost "core" en la ruta; la clave
# la entrega M9 en la ficha privada y va percent-encoded si tiene / ? # @ : o %):
# RABBITMQ_URL=amqps://module_ambiente:<clave-percent-encoded>@core-uade-2026.duckdns.org:5671/core
# En producción es obligatorio amqps:// y no se acepta el usuario guest. El
# puerto 5671 abre solo para las IP de salida dadas de alta en M9
# (Render: 74.220.48.0/24 y 74.220.56.0/24, habilitadas el 28/10). El usuario de la URL va como userId de cada
# mensaje y NO es el CORE_MODULE_SECRET.
#
# Exchange y cola los crea el Core; M6 solo los verifica. Son los defaults:
# DÓNDE: no definirlos en RENDER (borrar los overrides viejos `municipalidad.events`
# y `m6.ambiente` y las variables eliminadas RABBITMQ_EXCHANGE_TYPE,
# RABBITMQ_DEAD_LETTER_EXCHANGE y KAFKA_*; si no, el broker responde 404).
RABBITMQ_EXCHANGE=muni.inbox
RABBITMQ_QUEUE=q.ambiente
# Mensajes sin confirmar a la vez. Los reintentos y la DLQ los hace el Core
# (escalones de 5 s, 30 s, 2 min y 10 min, docs/integracion/m9.md).
RABBITMQ_PREFETCH=1

# ─── Core (M9) ────────────────────────────────────
# Nuestro módulo ante el Core: va como sourceModule en el sobre.
CORE_MODULE_ID=ambiente
# API REST del Core. Sin CORE_API_URL la app arranca igual y no se le pide nada
# al Core. Con ella, CORE_MODULE_SECRET es obligatoria; en producción, https://.
# DÓNDE: RENDER. (readiness: /health/ready; la API es /api/v1)
# CORE_API_URL=https://core-uade-2026.duckdns.org
# Secret de máquina para pedir el token de módulo (15 min, sin refresh).
# DÓNDE: RENDER (SECRETO), solo en el panel. Lo entrega M9 en la ficha privada.
# CORE_MODULE_SECRET=<lo-entrega-M9>
# Registro de suscripciones y publicaciones en el catálogo del Core (al arrancar,
# solo con CORE_API_URL; también: npm run core:register). maxAttempts por
# suscripción (4 = cadena de reintentos del Core) e interruptor del arranque.
# DÓNDE: opcionales en RENDER; con más de una réplica, REGISTER_ON_BOOT=false.
# CORE_SUBSCRIPTION_MAX_ATTEMPTS=4
# CORE_REGISTER_ON_BOOT=true   (acepta true/false/1/0, sin distinguir mayúsculas)

# ─── Cloudflare R2 (evidencia/adjuntos, Issue #64) ─
# DÓNDE: RENDER (R2_ACCESS_KEY_ID y R2_SECRET_ACCESS_KEY son SECRETOS). Sin
# estas variables la app arranca, pero POST /evidence responde 503.
# R2_ACCOUNT_ID=<id-de-cuenta-de-cloudflare>
# R2_ACCESS_KEY_ID=<key-id-de-la-api-de-r2>
# R2_SECRET_ACCESS_KEY=<secret-de-la-api-de-r2>
# R2_BUCKET=m6-evidence
# Dominio público del bucket, sin barra final (si falta, /evidence no devuelve URL directa).
# R2_PUBLIC_URL_BASE=https://pub-xxxx.r2.dev

# ─── Solo para tests (no va a Render) ─────────────
# DÓNDE: LOCAL. Los specs contra el paquete de contratos de M2 v1.78 necesitan la
# ruta a su carpeta schemas/ (docs/documentacion no se versiona). Entre comillas
# si tiene espacios. Sin esta variable esos specs se saltean.
# M2_V178_SCHEMAS=<ruta>/docs/documentacion/otros modulos/m2/m2-eventos-v1.78/schemas

# ─── No son del backend (viven en VERCEL, repo del frontend) ───
# M6_AUTH_MODE=backend-development
# M6_BACKEND_ORIGIN=https://m6-backend-m64k.onrender.com
# M6_DEV_JWT=<token de demo firmado con el JWT_SECRET; dura 15 min>
# M6_SESSION_SECRET=<clave para sellar la cookie del BFF>
